# ==========================================
# Airball Sports Updates - Environment Configuration
# Copy this file to .env and replace dummy values with your real credentials.
# NEVER commit .env to version control!
# ==========================================

# TheSportsDB — Free tier key is typically "3", or provide your premium API key
THESPORTSDB_KEY=your_thesportsdb_key_here

# API-Sports (NFL and UFC integration)
# Set USE_API_SPORTS=true to enable API-Sports data provider
USE_API_SPORTS=false
API_SPORTS_KEY=your_api_sports_key_here
NFL_API_KEY=your_api_sports_key_here

# BallDontLie NBA Stats API Key (v1)
BALLDONTLIE_API_KEY=your_balldontlie_key_here
NBA_API_KEY=your_balldontlie_key_here

# Server Security & Strict CORS Configuration
# Comma-separated list of allowed origins (e.g. your production domain and local dev ports)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Rate Limiting (max requests per minute per IP address)
API_RATE_LIMIT=120

# Flask Application Settings
FLASK_ENV=development
FLASK_SECRET_KEY=change_me_to_a_random_32_byte_hex_string
AIRBALL_ENABLE_PREWARM=0
